#: indicators/default/package/config/config.qml
#, kde-format
msgid "Use Modern dot indicators"
msgstr "Folosește indicatorii cu puncte ai stilului modern"

#: indicators/default/package/config/config.qml
#, kde-format
msgid "Available for Modern docks. Keep the macOS-style dots, or disable to choose Line or Dots independently of the dock style"
msgstr "Pentru docuri în stil modern. Păstrează punctele în stil macOS sau dezactivează pentru a alege linii ori puncte independent de stilul docului"

#: indicators/default/package/config/config.qml
#, kde-format
msgid "Use application icon colors"
msgstr "Folosește culorile pictogramelor aplicațiilor"

#: indicators/default/package/config/config.qml
#, kde-format
msgid "Color task indicators using the dominant color of each application icon"
msgstr "Colorează indicatorii sarcinilor cu culoarea dominantă a pictogramei fiecărei aplicații"
